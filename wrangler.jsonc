// Cloudflare Workers: statické soubory ze složky web/ + malý worker (src/worker.js)
// pro přihlášky testerů na /api/tester.
// Název musí sedět s názvem projektu v Cloudflare (Workers & Pages).
// Hlavičky (web/_headers) a přesměrování (web/_redirects) Cloudflare čte i tady.
// Web: lifeos.romarte.cz (Custom domain v projektu; DNS romarte.cz je na Cloudflare).
{
  "name": "lifeosweb",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Logy zapnuté: každá přihláška je vidět v Cloudflare → lifeosweb → Logs.
  "observability": { "enabled": true },
  // E-mailové upozornění na každou přihlášku (Email Routing na romarte.cz, ověřená adresa).
  "send_email": [{ "name": "LIFEOS_MAIL", "destination_address": "artejsem@gmail.com" }]
}
